# Application
NODE_ENV=development
APP_NAME=MailBridge
APP_URL=http://localhost:3000
PORT=3000
LOG_LEVEL=info

# PostgreSQL. Use a dedicated least-privilege application user in production.
DATABASE_URL=postgresql://mailbridge:mailbridge_dev_password@localhost:5432/mailbridge?schema=public

# Generate with: openssl rand -base64 32
# Set a unique value outside source control. Used for encrypting provider credentials.
# Must decode to 32 bytes for AES-256-GCM.
PROVIDER_ENCRYPTION_KEY_BASE64=REPLACE_WITH_BASE64_32_BYTE_KEY

# Transactional email provider. Keep server-only; never expose with NEXT_PUBLIC_.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=
DEFAULT_FROM_NAME=MailBridge

# Optional worker controls
WORKER_POLL_INTERVAL_MS=1000
WORKER_MAX_ATTEMPTS=5
WORKER_CONCURRENCY=5

# Do not set real production values in this file.

# Resend webhook signing secret (whsec_...). Configure a signed webhook in the provider dashboard.
RESEND_WEBHOOK_SECRET=
